# Algorand network to settle on: 'testnet' (default, play money) or
# 'mainnet' (REAL money — double-check AVM_ADDRESS before switching).
# Any other value fails fast at boot rather than settling wrong-network.
ALGORAND_NETWORK=testnet
# Merchant (resource server) Algorand public address on the network above —
# receives the $0.01 USDC.
AVM_ADDRESS=
# GoPlausible hosted facilitator (no API key needed).
FACILITATOR_URL=https://facilitator.goplausible.xyz
# Payer mnemonic for the local end-to-end test client ONLY. Never commit.
AVM_MNEMONIC=
# Port for the premium API.
PORT=4021
# Optional: Gemini API key (Google AI Studio, free tier) enabling Luna's
# interpretive answers. Without it, Luna still answers every factual
# question deterministically from logged data.
GEMINI_API_KEY=
